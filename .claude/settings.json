{
  "permissions": {
    "allow": [
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git status:*)",
      "Bash(git tag:*)",
      "Bash(git fetch:*)",
      "Bash(node --version)",
      "Bash(python3 -c:*)",
      "Bash(ls:*)",
      "Bash(cat CHANGELOG.md)",
      "Bash(cat manifest.json)",
      "Bash(cat hacs.json)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo '\\n🏠 home-assistant-skills plugin loaded\\nAvailable skills: /ha-validate  /ha-entities  /ha-release  /ha-review\\nRepository: lovelace-sigen-house-card (HACS Lovelace card)\\n'"
          }
        ]
      }
    ]
  }
}
